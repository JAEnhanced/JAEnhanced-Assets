gfx/effects/clone/blaster_blob
{
	cull	twosided
    {
        map gfx/effects/clone/blaster_blob
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        alphaGen vertex
    }
}

gfx/effects/clone/blasterSideFlash
{
	cull	twosided
    {
        map gfx/effects/clone/blastersideflash
        blendFunc GL_ONE GL_ONE
        rgbGen vertex
    }
}

gfx/effects/clone/blasterFrontFlash
{
	cull	twosided
    {
        map gfx/effects/clone/blasterfrontflash
        blendFunc GL_ONE GL_ONE
        rgbGen vertex
    }
}


