models/weapons2/cloneblst/cloneblaster_w
{
	q3map_nolightmap
    {
        map models/weapons2/cloneblst/cloneblaster_w
        rgbGen lightingDiffuse
    }
    {
        map models/weapons2/cloneblst/cloneblaster_w-spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}

