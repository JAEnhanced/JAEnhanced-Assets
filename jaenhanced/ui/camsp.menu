		{
			name				fov_reset
			group				resets
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				325 200 340 14
			text				"Reset"
			descText			"Reset Field of View to 80"
			font				4
			textscale			1
			textalign			ITEM_ALIGN_LEFT
			textstyle			1
			forecolor			.615 .615 .956 1
			visible				1
			action 
			{ 
				play			"sound/interface/button1.wav" ; 
				exec			"reset cg_fov"
			}	  	  
		}
